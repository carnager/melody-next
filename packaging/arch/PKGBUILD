# Maintainer: Rasmus Steinke <rasi@xssn.at>
#
# One build, four packages: the window, the engine, the agent and the CLI.
# A server needs only melodyd-git; a room with speakers only
# melody-agent-git; a desktop trackknife-git, which brings the engine.
pkgbase=trackknife-git
pkgname=(trackknife-git melodyd-git melody-agent-git melody-cli-git)
pkgver=r0
pkgrel=1
arch=(x86_64 aarch64)
url="https://github.com/carnager/trackknife"
license=(GPL-3.0-only)
makedepends=(cmake git ninja nlohmann-json qt6-base
             curl ffmpeg libebur128 libopenmpt libpipewire libutf8proc openssl sqlite taglib)
source=("trackknife::git+https://github.com/carnager/trackknife.git")
sha256sums=('SKIP')

pkgver() {
  cd trackknife
  printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd trackknife
  # Warnings-as-errors stays off so packaging never fails on warnings a
  # future compiler invents. Tests are opt-in: export TRACKKNIFE_CHECK=1.
  local testing=OFF
  [[ -n ${TRACKKNIFE_CHECK:-} ]] && testing=ON
  cmake --preset release -DCMAKE_INSTALL_PREFIX=/usr \
    -DTRACKKNIFE_WARNINGS_AS_ERRORS=OFF -DBUILD_TESTING=$testing \
    -DTRACKKNIFE_BUILD_BENCHMARKS=OFF
  cmake --build build/release
}

check() {
  [[ -n ${TRACKKNIFE_CHECK:-} ]] || return 0
  cd trackknife/build/release
  QT_QPA_PLATFORM=offscreen ctest --output-on-failure
}

_install() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/trackknife/build/release" --component "$1"
}

package_trackknife-git() {
  pkgdesc="Music player and audio workstation: library, tagging, conversion, ReplayGain"
  depends=(melodyd-git qt6-base
           curl ffmpeg libebur128 libopenmpt libpipewire libutf8proc openssl sqlite taglib)
  optdepends=('chromaprint: AcoustID fingerprinting in the MusicBrainz Identify dialog'
              'melody-cli-git: the engine from the shell')
  provides=(trackknife)
  conflicts=(trackknife trackbench-git)
  replaces=(trackbench-git)
  _install app
  cd "$srcdir/trackknife"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY.md "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY.md"
}

package_melodyd-git() {
  pkgdesc="Melody music engine: library, playback and outputs, shared on the network"
  depends=(curl ffmpeg libopenmpt libpipewire libutf8proc openssl sqlite taglib)
  provides=(melodyd)
  conflicts=(melodyd)
  _install engine
  install -Dm644 "$srcdir/trackknife/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_melody-agent-git() {
  pkgdesc="Speakers for Melody engines: finds the engines on the network and plays for them"
  depends=(curl ffmpeg libopenmpt libpipewire libutf8proc openssl sqlite taglib)
  provides=(melody-agent)
  conflicts=(melody-agent)
  _install agent
  install -Dm644 "$srcdir/trackknife/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_melody-cli-git() {
  pkgdesc="Melody engines from the shell: playback, the queue, the library by words"
  depends=(libutf8proc)
  provides=(melody-cli)
  conflicts=(melody-cli)
  _install cli
  install -Dm644 "$srcdir/trackknife/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

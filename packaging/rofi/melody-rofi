#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
#
# Pick an album -- or a track -- in rofi, then put it in Up Next, add it to
# the list that plays, or replace that list with it and play.
#
#   melody-rofi                          # albums, from the engine melody-cli finds
#   melody-rofi tracks                   # tracks
#   melody-rofi tracks --engine gemenon  # any melody-cli options go to melody-cli
#
# Needs melody-cli and rofi.

set -euo pipefail

kind=album
case "${1:-}" in
    albums) shift ;;
    tracks) kind=track; shift ;;
esac

cli() { melody-cli "$@"; }
say() { notify-send -a Melody "$1" "${2:-}" 2>/dev/null || printf '%s\n' "$1 ${2:-}" >&2; }

# A line to show, then a tab and the key -- melody-cli --keys writes them
# so, asking the engine for no more than the lines need. rofi shows the
# first column and hands back the whole line.
if [ "${kind}" = album ]; then
    lines="$(cli "$@" --keys albums)" || { say "Melody" "Could not list the albums"; exit 1; }
    prompt=Album
else
    lines="$(cli "$@" --keys tracks)" || { say "Melody" "Could not list the tracks"; exit 1; }
    prompt=Track
fi

chosen="$(printf '%s\n' "${lines}" |
    rofi -dmenu -i -p "${prompt}" -display-columns 1 -display-column-separator $'\t')" || exit 0
name="${chosen%%$'\t'*}"
key="${chosen##*$'\t'}"
[ -n "${key}" ] || exit 0

action="$(printf '%s\n' 'Up Next' 'Add to the list' 'Replace and play' |
    rofi -dmenu -i -p "${name}")" || exit 0

case "${action}" in
    'Up Next') words=(queue "${kind}" --key "${key}") ;;
    'Add to the list') words=(add "${kind}" --key "${key}") ;;
    'Replace and play') words=(play "${kind}" --key "${key}") ;;
    *) exit 0 ;;
esac

if ! error="$(cli "$@" "${words[@]}" 2>&1 >/dev/null)"; then
    say "Melody" "${error#melody-cli: }"
    exit 1
fi

#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
#
# Pick an album in rofi, then put it in Up Next, add it to the list that
# plays, or replace that list with it and play.
#
#   melody-rofi                    # the engine melody-cli finds by itself
#   melody-rofi --engine gemenon   # any melody-cli options go to melody-cli
#
# Needs melody-cli, rofi and jq.

set -euo pipefail

cli() { melody-cli "$@"; }
say() { notify-send -a Melody "$1" "${2:-}" 2>/dev/null || printf '%s\n' "$1 ${2:-}" >&2; }

# "Artist — Album (Year)", then a tab and the album's key: rofi shows the
# first column and hands back the whole line.
albums="$(cli "$@" --json albums | jq -r '.[] |
    "\(.artist) — \(.album // .label)\(if (.date // "") != "" then " (\(.date[0:4]))" else "" end)\t\(.key)"')" ||
    { say "Melody" "Could not list the albums"; exit 1; }

chosen="$(printf '%s\n' "${albums}" |
    rofi -dmenu -i -p Album -display-columns 1 -display-column-separator $'\t')" || exit 0
name="${chosen%%$'\t'*}"
key="${chosen##*$'\t'}"
[ -n "${key}" ] || exit 0

action="$(printf '%s\n' 'Up Next' 'Add to the list' 'Replace and play' |
    rofi -dmenu -i -p "${name}")" || exit 0

case "${action}" in
    'Up Next') words=(queue album --key "${key}") ;;
    'Add to the list') words=(add album --key "${key}") ;;
    'Replace and play') words=(play album --key "${key}") ;;
    *) exit 0 ;;
esac

if ! error="$(cli "$@" "${words[@]}" 2>&1 >/dev/null)"; then
    say "Melody" "${error#melody-cli: }"
    exit 1
fi

#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
#
# Pick an album -- or a track -- in rofi, then put it in Up Next, add it to
# the list that plays, or replace that list with it and play.
#
#   melody-rofi                          # albums, from the engine melody-cli finds
#   melody-rofi tracks                   # tracks
#   melody-rofi random-album             # play an album of a random album artist
#   melody-rofi random-tracks [COUNT]    # play random tracks; asks how many
#   melody-rofi tracks --engine gemenon  # any melody-cli options go to melody-cli
#
# Needs melody-cli and rofi.

set -euo pipefail

cli() { melody-cli "$@"; }
say() { notify-send -a Melody "$1" "${2:-}" 2>/dev/null || printf '%s\n' "$1 ${2:-}" >&2; }

# Played at once, as the engine chooses; what it chose is said.
play_random() {
    local chosen
    if chosen="$(cli "$@" 2>&1 >/dev/null)"; then
        say "Melody" "${chosen#melody-cli: }"
    else
        say "Melody" "${chosen#melody-cli: }"
        exit 1
    fi
}

kind=album
icon=vinyl
case "${1:-}" in
    albums) shift ;;
    tracks) kind=track; icon=media-album-track; shift ;;
    random-album)
        shift
        play_random "$@" play random album
        exit 0
        ;;
    random-tracks)
        shift
        count=
        if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
            count="$1"
            shift
        else
            count="$(printf '%s\n' 10 25 50 100 | rofi -dmenu -p 'Random tracks')" || exit 0
        fi
        [[ "${count}" =~ ^[1-9][0-9]*$ ]] || { say "Melody" "How many tracks: a number"; exit 1; }
        play_random "$@" play random tracks "${count}"
        exit 0
        ;;
esac

# A line to show, then a tab and the key -- melody-cli --keys writes them
# so, asking the engine for no more than the lines need. rofi shows the
# first column and hands back the whole line.
#
# Kept in a file with the library's revision on its first line: while the
# engine says the same revision, the library has not changed and the list
# is read from there. rofi reads it straight from the file -- through a
# shell variable, 67,000 tracks took three times as long as rofi needs. An
# engine too old to have a revision is listed every time.
cache="${XDG_CACHE_HOME:-${HOME}/.cache}/melody-rofi/$(printf '%s\n' "${kind}" "$@" |
    md5sum | cut -c1-16)"
mkdir -p "${cache%/*}"
revision="$(cli "$@" revision 2>/dev/null)" || revision=
list="${cache}"
if [ -z "${revision}" ] || [ ! -f "${cache}" ] || [ "$(head -n 1 "${cache}")" != "${revision}" ]; then
    list="$(mktemp "${cache}.XXXXXX")"
    trap 'rm -f "${list}"' EXIT
    { printf '%s\n' "${revision}" && cli "$@" --keys "${kind}s"; } > "${list}" ||
        { say "Melody" "Could not list the ${kind}s"; exit 1; }
    if [ -n "${revision}" ]; then
        mv "${list}" "${cache}"
        list="${cache}"
        trap - EXIT
    fi
fi

# Each line gets an icon from the icon theme (Papirus has both); rofi shows
# it beside the line and hands back the line without it.
chosen="$(tail -n +2 "${list}" |
    awk -v icon="${icon}" '{ printf "%s%cicon%c%s\n", $0, 0, 31, icon }' |
    rofi -dmenu -i -show-icons -p "${kind^}" \
        -display-columns 1 -display-column-separator $'\t')" || exit 0
name="${chosen%%$'\t'*}"
key="${chosen##*$'\t'}"
[ -n "${key}" ] || exit 0

action="$(printf '%s\n' 'Up Next' 'Add to the list' 'Replace and play' |
    rofi -dmenu -i -p "${name}")" || exit 0

case "${action}" in
    'Up Next') words=(queue "${kind}" --key "${key}") ;;
    'Add to the list') words=(add "${kind}" --key "${key}") ;;
    'Replace and play') words=(play "${kind}" --key "${key}") ;;
    *) exit 0 ;;
esac

if ! error="$(cli "$@" "${words[@]}" 2>&1 >/dev/null)"; then
    say "Melody" "${error#melody-cli: }"
    exit 1
fi

[Unit]
# ADR-0220: the engine owns the library and playback, and outlives any
# window: music keeps playing with Trackknife closed, and starts without it.
# On a desktop Trackknife starts the engine itself; this unit is for a
# machine that plays without anyone logged in -- a server, a Pi -- with
#   loginctl enable-linger $USER
# so it runs from boot.
Description=melodyd, the Melody music engine
After=pipewire.service network-online.target
Wants=pipewire.service network-online.target

[Service]
Type=simple
# Options in ~/.config/melody/melodyd.conf, e.g.
#   MELODYD_OPTIONS=--name gemenon --agent --password-file /home/you/.config/melody/password
# With a password it listens on port 6603 (streams on 6604) and announces
# itself on the network; without one, or with --local-only, it keeps to this
# machine.
EnvironmentFile=-%h/.config/melody/melodyd.conf
ExecStart=/usr/bin/melodyd $MELODYD_OPTIONS
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

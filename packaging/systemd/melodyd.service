[Unit]
# ADR-0220: the engine owns the library and playback, and outlives any
# window: music keeps playing with Melody closed, and starts without it.
# On a desktop melodyd.socket starts it on the first connection; this unit
# enabled is for a machine that plays without anyone logged in -- a server,
# a Pi -- with
#   loginctl enable-linger $USER
# so it runs from boot.
Description=melodyd, the Melody music engine
After=pipewire.service network-online.target
Wants=pipewire.service network-online.target

[Service]
Type=simple
# ADR-0286: settings in ~/.config/melody/melodyd.conf, which
#   melody-cli config --edit
# starts from a commented skeleton; or one at a time:
#   melody-cli config password 'a long sentence'
# With a password it listens on port 6603 (streams on 6604) and announces
# itself on the network; without one, or with local-only = yes, it keeps to
# this machine.
ExecStart=/usr/bin/melodyd
# Started again whenever it stops by itself -- engine.restart is an exit --
# but not after systemctl stop.
Restart=always
RestartSec=1
# engine.stop -- Melody's Quit and stop engine -- is not restarted after;
# the next client on the socket starts it.
RestartPreventExitStatus=64

[Install]
WantedBy=default.target
# melodyd.socket hands it its socket (ADR-0286).
Also=melodyd.socket

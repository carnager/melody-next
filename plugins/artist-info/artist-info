"""Melody panel plugin (ADR-0291): the playing artist, from public data.

MusicBrainz finds the artist -- by the album playing where it can, by name
otherwise -- and its Wikidata entry names the Wikipedia article, whose
summary and photo the panel shows, with links. Nothing is asked of anyone's
own server and no account is needed. What is found is kept a week in the
cache folder, so the same artist is not looked up every track; MusicBrainz
is asked at most once a second, as it asks -- by every run together, the
panel being run anew for each track -- and a 503, its answer to being asked
too often, is asked again after the wait it names.
"""
import fcntl
import hashlib
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

AGENT = "Melody-artist-info/1 (https://github.com/carnager/melody-next)"
KEPT = 7 * 24 * 3600
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                     "melody", "plugins", "artist-info")
TRIES = 4


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def musicbrainz_turn():
    """Waits until a second has passed since any run last asked MusicBrainz.

    The time is kept in a file every run locks while it waits, so runs that
    overlap -- one track after another, a refresh -- take turns.
    """
    os.makedirs(CACHE, exist_ok=True)
    with open(os.path.join(CACHE, "musicbrainz.turn"), "a+", encoding="utf-8") as turn:
        fcntl.flock(turn, fcntl.LOCK_EX)
        turn.seek(0)
        try:
            last = float(turn.read().strip() or 0)
        except ValueError:
            last = 0.0
        wait = 1.1 - (time.time() - last)
        if 0 < wait <= 1.1:
            time.sleep(wait)
        turn.seek(0)
        turn.truncate()
        turn.write("%.3f" % time.time())
        turn.flush()


def fetch(url, binary=False):
    host = urllib.parse.urlsplit(url).netloc
    for attempt in range(TRIES):
        if host == "musicbrainz.org":
            musicbrainz_turn()
        request = urllib.request.Request(url, headers={"User-Agent": AGENT})
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                body = response.read()
            return body if binary else json.loads(body)
        except urllib.error.HTTPError as error:
            if error.code == 404:
                return None
            # Asked too often, or busy: again after the wait it names.
            if error.code in (429, 503) and attempt + 1 < TRIES:
                try:
                    wait = float(error.headers.get("Retry-After") or 0)
                except ValueError:
                    wait = 0
                time.sleep(min(max(wait, 1.0 + attempt), 8.0))
                continue
            fail("%s answered %s%s" % (host, error.code,
                                       ", too often asked; try again in a while"
                                       if error.code in (429, 503) else ""))
        except Exception as error:
            fail("%s: %s" % (host, error))
    return None


def cached(name):
    path = os.path.join(CACHE, name)
    try:
        if time.time() - os.path.getmtime(path) < KEPT:
            with open(path, encoding="utf-8") as kept:
                return json.load(kept)
    except (OSError, ValueError):
        pass
    return None


def keep(name, value):
    os.makedirs(CACHE, exist_ok=True)
    path = os.path.join(CACHE, name)
    with open(path + ".partial", "w", encoding="utf-8") as kept:
        json.dump(value, kept)
    os.replace(path + ".partial", path)


def quoted(text):
    return '"%s"' % text.replace("\\", "\\\\").replace('"', '\\"')


def artist_id(artist, album):
    """The MusicBrainz artist: the one who made this album, else by name."""
    key = "id-" + hashlib.sha1(("%s\x1f%s" % (artist.casefold(), album.casefold()))
                               .encode("utf-8")).hexdigest()
    known = cached(key)
    if known is not None:
        return known.get("id")
    found = None
    if album:
        query = "releasegroup:%s AND artist:%s" % (quoted(album), quoted(artist))
        groups = (fetch("https://musicbrainz.org/ws/2/release-group/?fmt=json&limit=5&query="
                        + urllib.parse.quote(query)) or {}).get("release-groups") or []
        for group in groups:
            credits = group.get("artist-credit") or []
            if group.get("score", 0) >= 90 and credits:
                found = credits[0]["artist"]["id"]
                break
    if found is None:
        artists = (fetch("https://musicbrainz.org/ws/2/artist/?fmt=json&limit=3&query="
                         + urllib.parse.quote("artist:" + quoted(artist))) or {}).get("artists") or []
        exact = [a for a in artists if a.get("score", 0) >= 95
                 and a.get("name", "").casefold() == artist.casefold()]
        found = exact[0]["id"] if exact else None
    keep(key, {"id": found})
    return found


def about(mbid, language):
    """What is said of the artist, gathered once a week."""
    key = "about-%s-%s" % (mbid, language)
    known = cached(key)
    if known is not None:
        return known
    artist = fetch("https://musicbrainz.org/ws/2/artist/%s?inc=url-rels&fmt=json" % mbid) or {}
    links = {"MusicBrainz": "https://musicbrainz.org/artist/" + mbid}
    wikidata = None
    for relation in artist.get("relations") or []:
        url = (relation.get("url") or {}).get("resource") or ""
        if relation.get("type") == "official homepage" and url.startswith("http"):
            links.setdefault("Official site", url)
        elif relation.get("type") == "wikidata":
            wikidata = url.rstrip("/").rsplit("/", 1)[-1]
    summary = None
    if wikidata:
        entity = (fetch("https://www.wikidata.org/wiki/Special:EntityData/%s.json" % wikidata)
                  or {}).get("entities", {}).get(wikidata, {})
        sitelinks = entity.get("sitelinks") or {}
        for wiki in dict.fromkeys([language, "en"]):
            title = (sitelinks.get(wiki + "wiki") or {}).get("title")
            if title:
                summary = fetch("https://%s.wikipedia.org/api/rest_v1/page/summary/%s"
                                % (wiki, urllib.parse.quote(title.replace(" ", "_"))))
                break
    image = None
    if summary:
        page = ((summary.get("content_urls") or {}).get("desktop") or {}).get("page")
        if page:
            links = {"Wikipedia": page, **links}
        thumbnail = (summary.get("thumbnail") or {}).get("source")
        if thumbnail:
            picture = fetch(thumbnail, binary=True)
            if picture:
                os.makedirs(CACHE, exist_ok=True)
                image = os.path.join(CACHE, "%s.jpg" % mbid)
                with open(image + ".partial", "wb") as kept:
                    kept.write(picture)
                os.replace(image + ".partial", image)
    span = artist.get("life-span") or {}
    begun = (span.get("begin") or "")[:4]
    ended = (span.get("end") or "")[:4]
    where = ", ".join(n for n in ((artist.get("begin-area") or {}).get("name"),
                                  (artist.get("area") or {}).get("name")) if n)
    told = {
        "name": artist.get("name") or "",
        "kind": artist.get("type") or "",
        "where": where,
        "when": "%s – %s" % (begun, ended) if ended else ("since %s" % begun if begun else ""),
        "summary": (summary or {}).get("extract") or "",
        "page": ((summary or {}).get("content_urls") or {}).get("desktop", {}).get("page", ""),
        "image": image or "",
        "links": links,
    }
    keep(key, told)
    return told


def main():
    given = json.load(sys.stdin)
    playing = given.get("playing") or {}
    artist = (playing.get("album_artist") or playing.get("artist") or "").strip()
    album = (playing.get("album") or "").strip()
    language = str((given.get("settings") or {}).get("language") or "en").strip().lower() or "en"
    if not artist:
        print(json.dumps({"title": "", "parts": [{"paragraph": "The track names no artist."}]}))
        return
    mbid = artist_id(artist, album)
    if not mbid:
        print(json.dumps({"title": artist, "parts": [
            {"paragraph": "MusicBrainz knows no artist of that name for certain."}]}))
        return
    told = about(mbid, language)
    parts = []
    if told["image"] and os.path.exists(told["image"]):
        parts.append({"image": told["image"], **({"url": told["page"]} if told["page"] else {})})
    line = " from ".join(p for p in (told["kind"], told["where"]) if p)
    if line or told["when"]:
        parts.append({"text": line or told["name"], **({"detail": told["when"]} if told["when"] else {})})
    if told["summary"]:
        parts.append({"paragraph": told["summary"]})
    parts.append({"heading": "Links"})
    for name, url in told["links"].items():
        parts.append({"text": name, "url": url})
    print(json.dumps({"title": told["name"] or artist, "parts": parts}))


if __name__ == "__main__":
    main()

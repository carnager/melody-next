"""Melody plugin (ADR-0302): listening together, from Workspace › Run and a
panel.

The engine hosts a room or follows one; this asks it to, through melody-cli
-- MELODY_SERVER when the engine is elsewhere, as the Scripts plugin does --
and shows the room in a panel: what plays, who listens, the invite to send.
"""
import json
import os
import subprocess
import sys


def cli(given, *words, password=None):
    engine = given.get("engine") or {}
    env = dict(os.environ)
    if engine.get("address"):
        env["MELODY_SERVER"] = engine["address"]
    if password:
        env["MELODY_TOGETHER_PASSWORD"] = password
    try:
        done = subprocess.run(["melody-cli", "--json", *words], env=env, stdin=subprocess.DEVNULL,
                              capture_output=True, text=True, timeout=25)
    except FileNotFoundError:
        fail("melody-cli is not installed beside Melody")
    except subprocess.TimeoutExpired:
        fail("the engine did not answer")
    if done.returncode != 0:
        said = done.stderr.strip().splitlines()
        fail(said[-1].removeprefix("melody-cli: ") if said else "the engine refused")
    try:
        return json.loads(done.stdout.strip().splitlines()[-1]) if done.stdout.strip() else {}
    except ValueError:
        return {}


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def room_name(invite):
    return invite.split("/rooms/", 1)[-1].split("#", 1)[0] if "/rooms/" in invite else ""


def panel(given):
    """The room as its own queue: what plays, what is next, what the room
    suggests and votes for, who listens, what played -- apart from this
    Melody's own lists, which stay this Melody's."""
    room = cli(given, "together", "status")
    role = room.get("role") or ""
    if not role:
        parts = [{"paragraph": room.get("message") or
                  "Not in a listening room. Host one, or open an invite a friend sent you."}]
        print(json.dumps({"title": "Listening room", "parts": parts}))
        return
    parts = []
    if room.get("message"):
        parts.append({"paragraph": room["message"]})
    parts.append({"heading": "Now playing"})
    if room.get("track"):
        by = room.get("by")
        parts.append({"text": room["track"],
                      "detail": "suggested by %s" % by if by else
                                "the host's" if room.get("party") else "on the radio"})
    else:
        parts.append({"paragraph": "Nothing, for now."})
    if room.get("next"):
        parts.append({"heading": "Up next"})
        parts.append({"text": room["next"], "detail": "decided"})
    if room.get("party"):
        # ADR-0302 phase 4: what the room suggests, most wanted first.
        parts.append({"heading": "Suggested — the most votes plays next"})
        suggestions = room.get("suggestions") or []
        if not suggestions:
            parts.append({"paragraph": "Nothing yet: right-click a track, Suggest to the "
                                       "listening room."})
        for each in suggestions:
            votes = each.get("votes", 0)
            detail = " · ".join(p for p in (
                each.get("name", ""), "%d vote%s" % (votes, "" if votes == 1 else "s"),
                "" if each.get("ready") else "its copy on its way") if p)
            parts.append({"text": " — ".join(p for p in (each.get("artist"), each.get("title")) if p),
                          "detail": detail})
            # Everyone votes, the host as a guest; the host alone removes.
            parts.append({"link": "Take back my vote" if each.get("voted") else "Vote",
                          "detail": each.get("title", ""),
                          "url": "melody://together/vote?id=%d" % each.get("id", 0)})
            if role == "host":
                parts.append({"link": "Remove", "detail": each.get("title", ""),
                              "url": "melody://together/remove?id=%d" % each.get("id", 0)})
    listeners = room.get("listeners") or []
    parts.append({"heading": "Listening"})
    if listeners:
        parts += [{"text": name} for name in listeners]
    else:
        parts.append({"paragraph": "Nobody yet." if role == "host" else "Just you, and the host."})
    history = (room.get("history") or [])[:5]
    if history:
        parts.append({"heading": "Played"})
        parts += [{"text": track} for track in history]
    if role == "host" and room.get("invite"):
        parts.append({"heading": "Invite"})
        parts.append({"paragraph": "On your clipboard since you hosted: send it to your friends. "
                                   "It opens the room in their browser, or in their Melody."})
        # A button, not the address itself: an invite is too long to show.
        parts.append({"link": "Open the room", "detail": room["invite"], "url": room["invite"]})
    name = room_name(room.get("invite") or "")
    print(json.dumps({"title": "%s%s" % (name or "Listening room",
                                         " · hosting" if role == "host" else " · listening"),
                      "parts": parts}))


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("host", "join", "leave", "panel", "party",
                                                 "suggest"):
        fail("usage: together host|join|leave|panel|party|suggest")
    given = json.load(sys.stdin)
    settings = given.get("settings") or {}
    what = sys.argv[1]
    if what == "panel":
        panel(given)
    elif what == "host":
        server = str(settings.get("server") or "").strip()
        password = str(settings.get("password") or "").strip()
        if not server or not password:
            fail("Set the server and its password under Settings › Plugins › Listen together")
        name = str(settings.get("name") or "").strip() or os.environ.get("USER", "the host")
        room = str(settings.get("room") or "").strip().lower() or "-"
        answer = cli(given, "together", "host", server, room, name, password=password)
        # Just the invite: it goes onto the clipboard, to paste to friends.
        print(answer.get("invite", ""))
    elif what == "join":
        invite = str(settings.get("invite") or "").strip()
        if not invite:
            fail("Paste the invite under Settings › Plugins › Listen together first")
        name = str(settings.get("name") or "").strip() or os.environ.get("USER", "a friend")
        room = cli(given, "together", "join", invite, name)
        print("Listening along%s" % (": " + room["track"] if room.get("track") else ""))
    elif what == "party":
        on = not cli(given, "together", "status").get("party")
        cli(given, "together", "party", "on" if on else "off")
        print("A party: friends may suggest tracks and vote" if on else "The party is over")
    elif what == "suggest":
        paths = [track.get("path") for album in given.get("albums") or []
                 for track in album.get("tracks") or [] if track.get("path")]
        if not paths:
            fail("no tracks chosen")
        cli(given, "together", "suggest", *paths)
        print("Suggested to the room: %d track%s" % (len(paths), "" if len(paths) == 1 else "s"))
    else:
        cli(given, "together", "leave")
        print("Left the listening room")


if __name__ == "__main__":
    main()

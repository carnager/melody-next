# Qt's font fallback lookup leaves fontconfig-owned cache allocations alive at
# process exit. Keep leak checking enabled while excluding that external cache.
leak:FcFontRenderPrepare

# PipeWire's dynamically loaded SPA support modules retain process-global
# factory/cache allocations even after pw_deinit(). Adapter-owned streams,
# contexts, and loops are still destroyed normally.
leak:pw_context_load_module

# The same, where the plugins are built without frame pointers (Debian): the
# stack ends in the plugin itself. PIPEWIRE_DLCLOSE=false (the asan test
# preset) keeps it loaded so the frame has a module name to match.
leak:libspa-
